# -----------------------------------------------------------------------------
# Plantilla de variables de entorno.
#
# Este proyecto NO lee .env en tiempo de ejecucion (Angular compila las
# variables). El archivo real de configuracion es:
#     src/environments/environment.ts       (desarrollo)
#     src/environments/environment.prod.ts  (produccion)
#
# Copia este archivo a `.env` solo si automatizas la generacion de esos
# archivos en tu pipeline de CI.
# -----------------------------------------------------------------------------

# URL del proyecto Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave publica "anon" (Project Settings > API > Project API keys > anon public)
SUPABASE_ANON_KEY=eyJhbGciOi...

# Redirect que usa el login con Google en la web (debe estar en Supabase > Auth > URL Configuration)
AUTH_REDIRECT_WEB=http://localhost:8100/auth/callback

# Redirect (deep link) que usa el login con Google en Android / iOS
AUTH_REDIRECT_NATIVE=com.rodapp.hibrido://auth/callback
